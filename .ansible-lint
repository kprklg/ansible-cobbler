---
# ansible-lint configuration
# https://ansible.readthedocs.io/projects/lint/configuring/
#
# Формат совместим с ansible-lint 6.22.2 (ставится в CI через pip
# в venv). ansible-lint через apt (25.x) тоже работает, но формат
# ключей может слегка отличаться.

profile: production

# Пути для игнорирования
exclude_paths:
  - .cache/
  - .github/
  - filter_plugins/

# Все нужные отключения — через skip_list
skip_list:
  # Имя роли
  - role-name

  # Jinja2-шаблоны в YAML вызывают ложные срабатывания на отступах
  - jinja
  - jinja2
  - jinja[spacing]

  # Используем короткие имена модулей (apt вместо ansible.builtin.apt)
  - fqcn[action-core]

  # Одноразовые shell-команды не нуждаются в changed_when
  - no-changed-when

  # Handlers не используются в этой роли
  - no-handler

  # Переменные в defaults/main.yml не имеют префикса роли — ОК
  - var-naming[no-role-prefix]

  # Имена task-ов часто на русском — стандартные правила casing/template не подходят
  - name[casing]
  - name[template]

  # templates/*.j2 — Jinja templates сгенерированные Docker-контекстом,
  # permissions не нужны
  - risky-file-permissions

  # meta/main.yml: теги типа 'raspberry_pi' валидны в Galaxy, но не в
  # строгой схеме ansible-lint
  - meta-no-tags

  # meta/main.yml: 'dependencies' и 'max_ansible_version' — валидные
  # ключи в Galaxy, но ansible-lint их не знает
  - schema[meta]

  # pipefail в Ansible shell — не всегда нужен
  - risky-shell-pipe