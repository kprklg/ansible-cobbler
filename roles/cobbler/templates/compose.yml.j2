# Cobbler Stack — Universal (auto-generated by Ansible)
# Использует upstream образы ghcr.io/cobbler/* с inline-патчами
# Универсален: только IP хоста задаётся через mgmt_ip

networks:
  cobbler:
    name: cobbler
    driver: bridge
    ipam:
      config:
        - subnet: {{ cobbler_mgmt_network }}
  cobbler-pxe:
    name: cobbler-pxe
    external: true

volumes:
  cobbler-etc:
  cobbler-var-lib:
  cobbler-webdir:
  cobbler-tftproot:
  cobbler-dhcp-config:
  cobbler-dns-config:
  cobbler-dns-zones:



services:
  cobblerd:
    platform: linux/amd64
    image: cobbler/cobblerd-patched:latest
    command: ["cobblerd", "-F"]
    environment:
      COBBLER_XMLRPC_BIND_ADDRESS: "0.0.0.0"
    volumes:
      - cobbler-etc:/etc/cobbler:z
      - cobbler-var-lib:/var/lib/cobbler:z
      - cobbler-webdir:/srv/www/cobbler:z
      - cobbler-tftproot:/srv/tftpboot:z
      - cobbler-dhcp-config:/etc/cobbler-dhcp:z
      - cobbler-dns-config:/etc/cobbler-dns:z
      - cobbler-dns-zones:/var/lib/named:z
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks:
      - cobbler
    healthcheck:
      disable: true
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.cobbler-api.rule=PathPrefix(`/cobbler_api`)"
      - "traefik.http.routers.cobbler-api.priority=100"
      - "traefik.http.routers.cobbler-api.entrypoints=web"
      - "traefik.http.services.cobbler-api.loadbalancer.server.port=25151"
      - "traefik.http.middlewares.cobbler-api-strip.stripprefix.prefixes=/cobbler_api"
      - "traefik.http.middlewares.cobbler-api-cors.headers.accessControlAllowOriginList=*"
      - "traefik.http.middlewares.cobbler-api-cors.headers.accessControlAllowMethods=GET,POST,OPTIONS"
      - "traefik.http.middlewares.cobbler-api-cors.headers.accessControlAllowHeaders=content-type"
      - "traefik.http.routers.cobbler-api.middlewares=cobbler-api-strip,cobbler-api-cors"
    restart: unless-stopped

  http-api:
    platform: linux/amd64
    image: cobbler/cobblerd-patched:latest
    command: ["gunicorn", "cobbler.services:application", "--bind", "0.0.0.0:8000"]
    environment:
      COBBLER_XMLRPC_HOST: "cobblerd"
    volumes:
      - cobbler-webdir:/srv/www/cobbler:ro,z
      - cobbler-tftproot:/srv/tftpboot:ro,z
    networks:
      - cobbler
    depends_on:
      cobblerd:
        condition: service_started
    healthcheck:
      disable: true
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.cobbler-http-api.rule=PathPrefix(`/cblr`) || PathPrefix(`/httpboot`) || PathPrefix(`/images`)"
      - "traefik.http.routers.cobbler-http-api.priority=50"
      - "traefik.http.routers.cobbler-http-api.entrypoints=web"
      - "traefik.http.services.cobbler-http-api.loadbalancer.server.port=8000"
      - "traefik.http.middlewares.cobbler-svc-strip.stripprefix.prefixes=/cblr/svc"
      - "traefik.http.routers.cobbler-http-api.middlewares=cobbler-svc-strip"
    restart: unless-stopped

  web:
    platform: linux/amd64
    image: cobbler/cobbler-web-patched:latest
    volumes:
      - type: bind
        source: {{ cobbler_workdir }}/webroot
        target: /usr/share/nginx/html
        read_only: true
        bind:
          create_host_path: true
    networks:
      - cobbler
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.cobbler-web.rule=PathPrefix(`/`)"
      - "traefik.http.routers.cobbler-web.priority=1"
      - "traefik.http.services.cobbler-web.loadbalancer.server.port=8080"
    depends_on:
      cobblerd:
        condition: service_started
    restart: unless-stopped

  traefik:
    platform: linux/amd64
    image: traefik:v3.6
    command:
      - "--providers.docker=true"
      - "--providers.docker.exposedbydefault=false"
      - "--entrypoints.web.address=:80"
      - "--entrypoints.traefik.address=:8082"
      - "--api.dashboard=true"
      - "--api.insecure=true"
    ports:
      - "0.0.0.0:80:80"
      - "127.0.0.1:8082:8082"
    networks:
      - cobbler
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    security_opt:
      - no-new-privileges:true
      - label:disable
    restart: unless-stopped

  cobbler-tftp:
    platform: linux/amd64
    image: ghcr.io/cobbler/cobbler-tftp:latest
    environment:
      COBBLER_XMLRPC_HOST: "cobblerd"
    networks:
      cobbler:
        ipv4_address: {{ cobbler_mgmt_network | ipaddr('net') | ipaddr('+' ~ cobbler_tftp_mgmt_ip_offset ~ '') | ipaddr('address') }}
      cobbler-pxe:
        ipv4_address: {{ cobbler_pxe_network | ipaddr('net') | ipaddr('+' ~ cobbler_tftp_ip_offset ~ '') | ipaddr('address') }}
    depends_on:
      cobblerd:
        condition: service_started
    restart: unless-stopped

  cobbler-dhcp:
    platform: linux/amd64
    image: ghcr.io/cobbler/cobbler-dhcp:latest
    volumes:
      - cobbler-dhcp-config:/etc/cobbler-dhcp:ro,z
    networks:
      cobbler:
        ipv4_address: {{ cobbler_mgmt_network | ipaddr('net') | ipaddr('+' ~ cobbler_dhcp_mgmt_ip_offset ~ '') | ipaddr('address') }}
      cobbler-pxe:
        ipv4_address: {{ cobbler_pxe_network | ipaddr('net') | ipaddr('+' ~ cobbler_dhcp_ip_offset ~ '') | ipaddr('address') }}
    depends_on:
      cobblerd:
        condition: service_started
    restart: unless-stopped

  cobbler-dns:
    platform: linux/amd64
    image: cobbler/cobbler-dns-patched:latest
    cap_add:
      - NET_ADMIN
    volumes:
      - cobbler-dns-config:/etc/cobbler-dns:z
      - cobbler-dns-zones:/var/lib/named:z
    networks:
      cobbler:
        ipv4_address: {{ cobbler_mgmt_network | ipaddr('net') | ipaddr('+' ~ cobbler_dns_mgmt_ip_offset ~ '') | ipaddr('address') }}
      cobbler-pxe:
        ipv4_address: {{ cobbler_pxe_network | ipaddr('net') | ipaddr('+' ~ cobbler_dns_ip_offset ~ '') | ipaddr('address') }}
    depends_on:
      cobblerd:
        condition: service_started
    restart: unless-stopped